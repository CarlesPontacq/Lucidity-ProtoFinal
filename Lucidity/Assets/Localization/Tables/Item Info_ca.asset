MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Item Info_ca
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ca
  m_SharedData: {fileID: 11400000, guid: 835e25fed032bf042bf6ae117226d1b5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1137305509888
    m_Localized: "Corona dels Arquitectes \u2013 Protocol 24-C"
    m_Metadata:
      m_Items: []
  - m_Id: 1230284840960
    m_Localized: "Bea M\xFCller sol\xB7licita confirmaci\xF3 sobre un enviament de
      subministraments m\xE8dics d\u2019Artemis cap a l\u2019hospital del Districte,
      al qual Sebastian Schneider respon que ja estan en cam\xED i que comptaran
      amb un marge de vint minuts si arriben durant el canvi de torn. Dominik Uhlig
      afegeix que utilitzaran el desviament de la pedrera, una zona ja neta de testimonis,
      per traslladar el carregament als soterranis del Bloc C. Finalment, M\xFCller
      indica que la transacci\xF3 s\u2019ha de registrar formalment com una donaci\xF3
      per als cercles educatius, advertint que si el Leiter sospita que el poble
      s\u2019est\xE0 armant, es veuran obligats a avan\xE7ar els plans, posant en
      risc centenars de fam\xEDlies."
    m_Metadata:
      m_Items: []
  - m_Id: 1309729153024
    m_Localized: "Imatges incriminat\xF2ries"
    m_Metadata:
      m_Items: []
  - m_Id: 1387768373248
    m_Localized: "Aquestes tres imatges de seguiment de membres de la IFM documenten
      la vigil\xE0ncia realitzada a un subjecte durant diversos dies, captant de
      manera precisa els seus moviments clau. Les fotografies registren el moment
      exacte en qu\xE8 estableix comunicaci\xF3 amb un dels seus contactes, la posterior
      mobilitzaci\xF3 d\u2019un cami\xF3 amb un carregament sospit\xF3s i, finalment,
      el contingut d\u2019aquest carregament emmagatzemat en un dip\xF2sit clandest\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 1972521459712
    m_Localized: "Registre de sala d\u2019interrogaci\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 2079497183232
    m_Localized: "Aquest document oficial constitueix el registre cronol\xF2gic i
      de control dels procediments d\u2019interrogatori, estructurat en una matriu
      t\xE8cnica que identifica formalment els funcionaris policials actuants i els
      ciutadans sota condici\xF3 d\u2019acusats. La taula detalla amb precisi\xF3
      els par\xE0metres temporals de cada sessi\xF3, especificant l\u2019hora exacta
      d\u2019inici i de finalitzaci\xF3 del proc\xE9s de declaraci\xF3, garantint
      aix\xED el rigor administratiu de les actuacions i el compliment estricte dels
      protocols de seguretat nacional."
    m_Metadata:
      m_Items: []
  - m_Id: 1424908935168
    m_Localized: Carta al govern
    m_Metadata:
      m_Items: []
  - m_Id: 1756330254336
    m_Localized: "Es sol\xB7licita al Secretari General l\u2019assignaci\xF3 immediata
      de fons addicionals i divises per modernitzar les capacitats de vigil\xE0ncia
      amb dispositius d\u2019escolta especialitzats i sistemes de marcatge forense.
      Aquesta petici\xF3 respon a la intensificaci\xF3 de les activitats de la facci\xF3
      IFM, argumentant que els recursos actuals s\xF3n insuficients per neutralitzar
      aquesta amena\xE7a subversiva i garantir la seguretat operativa nacional sota
      els objectius del Leiter."
    m_Metadata:
      m_Items: []
  - m_Id: 284804833280
    m_Localized: "Peri\xF2dic"
    m_Metadata:
      m_Items: []
  - m_Id: 536416935936
    m_Localized: "La nostra p\xE0tria assegura la seva sobirania combinant vigil\xE0ncia
      defensiva i aliances estrat\xE8giques davant la inestabilitat global i les
      provocacions d\u2019estats ve\xEFns hostils. Sota la direcci\xF3 del Leiter,
      es consoliden els vincles amb els aliats leg\xEDtims, destacant l\u2019enfortiment
      de les relacions amb Nimsk com a soci inquebrantable. Els recents acords d\u2019ampli
      abast per a l\u2019intercanvi de b\xE9ns industrials i la protecci\xF3 m\xFAtua
      de rutes comercials blindades protegeixen l\u2019economia de totes dues nacions,
      enviant un senyal contundent contra els intents d\u2019a\xEFllament dels adversaris."
    m_Metadata:
      m_Items: []
  - m_Id: 997115092992
    m_Localized: "Aquest pamflet de la IFM convida els pares de fam\xEDlia a inscriure
      els seus fills als Cercles de Creixement perqu\xE8 siguin part del canvi i
      no deixin que altres decideixin les seves creences. A trav\xE9s d\u2019aquestes
      agrupacions, l\u2019organitzaci\xF3 busca formar el futur de la p\xE0tria des
      de la inf\xE0ncia, ensenyant lleialtat, veritat, identitat i disciplina mitjan\xE7ant
      activitats en equip per preparar les pr\xF2ximes generacions d\u2019una naci\xF3
      lliure."
    m_Metadata:
      m_Items: []
  - m_Id: 1802895417344
    m_Localized: Petits ciutadans, grans futurs!
    m_Metadata:
      m_Items: []
  - m_Id: 794731536384
    m_Localized: "Aquest \xE9s el pegat de la Policia del Poble, atorgat als ciutadans
      que, de manera volunt\xE0ria, fan serveis de vigil\xE0ncia i gesti\xF3 de l\u2019ordre
      p\xFAblic. En assumir aquestes tasques pel b\xE9 de la naci\xF3 i sota la direcci\xF3
      del Leiter, aquests homes demostren el seu ferm comprom\xEDs amb la seguretat
      col\xB7lectiva."
    m_Metadata:
      m_Items: []
  - m_Id: 706244304896
    m_Localized: Pegat de policia
    m_Metadata:
      m_Items: []
  - m_Id: 888960770048
    m_Localized: Diari de servei
    m_Metadata:
      m_Items: []
  - m_Id: 2940918226186240
    m_Localized: "INSTRUCCIONS D'\xDAS"
    m_Metadata:
      m_Items: []
  - m_Id: 4088905837109248
    m_Localized: Es busca
    m_Metadata:
      m_Items: []
  - m_Id: 4096229133836288
    m_Localized: "Aquesta imatge \xE9s una ordre d\u2019arrest oficial emesa contra
      Eduard M\xFCller, nascut el 14 de setembre de 1928. El text detalla els motius
      de l\u2019ordre, acusant-lo d\u2019organitzar i liderar la banda subversiva
      IFM, aix\xED com de cometre espionatge i agitaci\xF3 continuada contra el Leiter."
    m_Metadata:
      m_Items: []
  - m_Id: 4096573276479488
    m_Localized: El meu diari
    m_Metadata:
      m_Items: []
  - m_Id: 4096600363294720
    m_Localized: "Aquesta p\xE0gina del diari d\u2019un nen explica que el seu pare
      convida d\u2019amagat els seus amics a casa els dimarts per organitzar alguna
      cosa perillosa que t\xE9 la mare aterrida. El nen no s\u2019assabenta de res,
      per\xF2 descriu perfectament com l\u2019oncle Alfons el suborna amb caramels
      perqu\xE8 no en parli a l\u2019escola i com despr\xE9s el pare rep un sobre
      sospit\xF3s d\u2019un desconegut al parc."
    m_Metadata:
      m_Items: []
  - m_Id: 4096976940490752
    m_Localized: Postal
    m_Metadata:
      m_Items: []
  - m_Id: 4097012130701312
    m_Localized: "Aquesta postal de propaganda promociona un suposat viatge a Obano,
      una destinaci\xF3 costanera que el text impr\xE8s defineix com el paisatge
      m\xE9s bell de la gal\xE0xia. \xC9s una imatge excessivament perfecta que el
      Leiter utilitza per mantenir les masses motivades amb la promesa d\u2019una
      recompensa id\xEDl\xB7lica. \xC9s una eina de manipulaci\xF3 emocional, un
      miratge inabastable que molt probablement ni tan sols sigui real."
    m_Metadata:
      m_Items: []
  - m_Id: 4097405216677888
    m_Localized: "Aquest dibuix est\xE0 fet per un nen i sembla representar-se a
      ell mateix juntament amb la seva mare, tots dos amb cara trista i agafats de
      la m\xE0. El motiu \xE9s que just darrere seu hi ha el seu pare penjat pel
      coll amb una corda."
    m_Metadata:
      m_Items: []
  - m_Id: 4097377861427200
    m_Localized: Dibuix inquietant
    m_Metadata:
      m_Items: []
  - m_Id: 4097902342365184
    m_Localized: "Aquesta carta d\u2019una mare al seu fill Klaus explica que ha
      de fugir i creuar la frontera de manera immediata perqu\xE8 la Policia del
      Poble li segueix el rastre. La dona confessa que va assumir el c\xE0rrec del
      seu difunt marit a l\u2019organitzaci\xF3 dissident de la IFM, cosa que ha
      convertit la seva casa en un lloc perill\xF3s i justifica l\u2019allunyament
      del seu fill. En les seves paraules de comiat, li demana perd\xF3 i li exigeix
      que sigui valent i mantingui el cap fred, anteposant la lluita per la llibertat
      i el futur del pa\xEDs a la seva pr\xF2pia relaci\xF3 familiar."
    m_Metadata:
      m_Items: []
  - m_Id: 4097881114992640
    m_Localized: Carta
    m_Metadata:
      m_Items: []
  - m_Id: 4098341045592064
    m_Localized: "Objectiu seg\xFCent"
    m_Metadata:
      m_Items: []
  - m_Id: 4098380321054720
    m_Localized: "Aquesta directiva per a l\u2019agent T27 ordena la vigil\xE0ncia
      total sobre Sebastian Schneider, l\u2019objectiu 68445O. Li exigeix que registri
      cada pas que faci i cada persona amb qui parli sense deixar-se res fora. Ha
      de redactar un informe exhaustiu i lliurar qualsevol detall que pugui servir
      al Leiter per mantenir aquest individu completament vigilat."
    m_Metadata:
      m_Items: []
  - m_Id: 4098764712239104
    m_Localized: "Aquesta credencial a nom de Klaus M\xFCller l\u2019acredita oficialment
      com a reporter i fot\xF2graf d\u2019esdeveniments sota el n\xFAmero de registre
      54289K. El carnet detalla la seva data de naixement el 3 de mar\xE7 del 81,
      mostra una fotografia frontal del subjecte i compta amb la signatura de validaci\xF3
      del secretari N. S\xE4nde."
    m_Metadata:
      m_Items: []
  - m_Id: 4098746089529344
    m_Localized: "Identificaci\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 4099088445399040
    m_Localized: Contacte
    m_Metadata:
      m_Items: []
  - m_Id: 4099109756657664
    m_Localized: "La nota cont\xE9 les dades exactes per localitzar H. Kramer i indica
      clarament la seva adre\xE7a a Schmiedgasse 3, amb el codi postal 97506, sense
      afegir cap altre context ni signatura."
    m_Metadata:
      m_Items: []
  - m_Id: 4101394251440128
    m_Localized: Informe forense
    m_Metadata:
      m_Items: []
  - m_Id: 4101431865958400
    m_Localized: "Aquest informe m\xE8dic forense resumeix l\u2019aut\xF2psia d\u2019un
      ciutad\xE0 i certifica oficialment que la causa de la mort va ser un su\xEFcidi
      per penjament. El document descriu les marques de pressi\xF3 al coll i els
      danys interns, i conclou que el subjecte va morir pel pes del seu propi cos
      en penjar-se."
    m_Metadata:
      m_Items: []
  - m_Id: 4101920863084544
    m_Localized: "La Vida d\u2019una Rata"
    m_Metadata:
      m_Items: []
  - m_Id: 4101948608405504
    m_Localized: "Este poema trata sobre la muerte solitaria de una rata en un granero
      y de c\xF3mo absolutamente nadie lamenta su final. Explica que el roedor se
      dedicaba a actuar en la sombra, rompiendo hilos y destruyendo la confianza,
      por lo que su desaparici\xF3n solo trae una sensaci\xF3n de inmenso alivio
      al resto de la granja."
    m_Metadata:
      m_Items: []
  - m_Id: 4102338234081280
    m_Localized: "Aquesta fotografia documenta el lloc d\u2019enterrament d\u2019Eduard
      M\xFCller directament a la terra, en una zona descuidada i completament coberta
      de males herbes. La inscripci\xF3 funer\xE0ria presenta un error ortogr\xE0fic
      evident, cosa que demostra una manca d\u2019inter\xE8s o un treball fet amb
      massa pressa."
    m_Metadata:
      m_Items: []
  - m_Id: 4102318302748672
    m_Localized: Tomba
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
